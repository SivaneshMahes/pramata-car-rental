PORT=3001
# Leave APP_ORIGIN unset for automatic local defaults: dev 5173, npm start 3001.
# Set this to the exact public HTTPS origin when deploying.
# APP_ORIGIN=https://rentals.example.com
DATABASE_PATH=./data/rental.sqlite
UPLOAD_DIR=./uploads
SEED_DEMO=true
# Set NODE_ENV=production and SEED_DEMO=false on a public deployment.
# Google OAuth is optional locally. Register this callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
